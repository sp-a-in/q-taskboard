POSTGRES_DB=taskboard
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=dev-secret-change-me
DEBUG=true

# Airtable credentials — read ONLY by the airtable-adapter Node service.
# Django and the frontend never see these.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Tasks

# Shared secret Django sends to the adapter so it isn't a fully open
# internal endpoint. Optional for local dev; set the same value on both
# sides if you want it enforced.
AIRTABLE_ADAPTER_SHARED_SECRET=
